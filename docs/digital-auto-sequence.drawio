        <mxCell id="h-cloud" value="Kit Server (cloud)&lt;br&gt;kit.digitalauto.tech&lt;br&gt;Socket.IO routing" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="290" y="285" width="180" height="75" as="geometry"/></mxCell>
