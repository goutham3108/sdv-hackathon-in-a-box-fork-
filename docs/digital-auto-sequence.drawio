<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="24.7.17" type="device">
  <diagram id="digital-auto-runtime-sequence" name="digital.auto - remote runtime sequence">
    <mxGraphModel dx="2800" dy="7800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="7940" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="digital.auto ↔ SDV Runtime ↔ remote hardware — one chronological runtime sequence" style="text;html=1;fontSize=23;fontStyle=1;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2700" height="45" as="geometry"/></mxCell>
        <mxCell id="scope" value="Scope: default KUKSA command path, HW-1(RPi-1) native broker + SCORE middleware, ARM64 Runtime container, HW-2(RPi-2) UDP application. Blue = digital.auto; purple = cloud/backend; orange = runtime/middleware; green = remote/hardware. Solid arrows = requests/calls; dashed arrows = replies/events. Every numbered arrow is one step; loop and alt frames describe repetition/alternatives, not additional diagram pages." style="shape=note;html=1;whiteSpace=wrap;size=15;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacing=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="75" width="2700" height="85" as="geometry"/></mxCell>
        <mxCell id="boundary" value="Browser + backend frontend source is not included: browser emissions/rendering and the hosted deployment of the bundled Kit Manager protocol are marked (assumed). Runtime-side event names are verified. No login/token validation is implemented by the bundled register_client/register_kit handlers; identity fields are not authentication. Native broker uses Authorization::Disabled. The default cloud URL is https://kit.digitalauto.tech, not the local :3090 service." style="shape=note;html=1;whiteSpace=wrap;size=15;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="2700" height="95" as="geometry"/></mxCell>

        <mxCell id="phase1" value="seq 1 — Connection, runtime discovery, identity, Vehicle API selection" style="rounded=0;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;spacing=12;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="375" width="2700" height="1110" as="geometry"/></mxCell>
        <mxCell id="phase2" value="seq 2 — digital.auto → remote: execute application, read Vehicle API, issue high-beam command" style="rounded=0;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;spacing=12;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1530" width="2700" height="2110" as="geometry"/></mxCell>
        <mxCell id="runalt" value="alt [run_python_app: single Python source | JSON project]" style="rounded=0;fillColor=none;strokeColor=#d6b656;dashed=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="690" y="1760" width="680" height="285" as="geometry"/></mxCell>
        <mxCell id="cmdalt" value="alt [application SDK actuator request | dashboard write_signals_value / set_mock_signals]" style="rounded=0;fillColor=none;strokeColor=#d6b656;dashed=1;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="2360" width="1300" height="765" as="geometry"/></mxCell>
        <mxCell id="phase3" value="loop 3 — Remote → digital.auto: feedback / sensor values, SDK subscription, dashboard polling, stdout and status" style="rounded=0;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;spacing=12;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="3690" width="2700" height="2005" as="geometry"/></mxCell>
        <mxCell id="phase4" value="alt / loop 4 — Errors, reconnect, lease expiry, explicit stop and container teardown" style="rounded=0;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;spacing=12;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="5740" width="2700" height="1775" as="geometry"/></mxCell>

