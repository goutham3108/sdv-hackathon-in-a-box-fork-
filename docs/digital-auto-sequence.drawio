        <mxCell id="a-remote" style="fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="2353" y="3480" width="14" height="640" as="geometry"/></mxCell>

        <mxCell id="m01" value="01. start_services.sh: node Kit Manager :3090; Python syncer (OS process launch)" style="html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=200;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="430" as="sourcePoint"/><mxPoint x="820" y="430" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m02" value="02. VSSClient.connect(): 127.0.0.1:55555 (gRPC / VAL v1)" style="html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=390;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="510" as="sourcePoint"/><mxPoint x="1260" y="510" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m03" value="03. sio.connect(SYNCER_SERVER_URL), default https://kit.digitalauto.tech (Socket.IO / TLS)" style="html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=400;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="590" as="sourcePoint"/><mxPoint x="380" y="590" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m04" value="04. register_kit {kit_id, name}; CLIENT_ID = RUNTIME_PREFIX + RUNTIME_NAME (Socket.IO)" style="html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=400;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="670" as="sourcePoint"/><mxPoint x="380" y="670" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m05" value="05. Open Playground model/application, connect to Kit Server (HTTPS + Socket.IO; assumed)" style="html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=200;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="750" as="sourcePoint"/><mxPoint x="380" y="750" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m06" value="06. register_client {username, user_id, domain} (Socket.IO; browser emission assumed)" style="html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=200;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="830" as="sourcePoint"/><mxPoint x="380" y="830" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m07" value="07. list-all-kits-result [{kit_id, name, is_online, ...}] (Socket.IO event)" style="html=1;dashed=1;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=200;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="910" as="sourcePoint"/><mxPoint x="160" y="910" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m08" value="08. Select Runtime-sdv-hackathon; clientSubscribeToKit {kit_id} (Socket.IO; UI assumed)" style="html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=200;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="990" as="sourcePoint"/><mxPoint x="380" y="990" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m09" value="09. messageToKit {to_kit_id, cmd: subscribe_apis, apis: [Vehicle.Speed, Vehicle.Body.Lights.Beam.High.IsOn]} (Socket.IO; UI assumed)" style="html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=200;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="1070" as="sourcePoint"/><mxPoint x="380" y="1070" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m10" value="10. messageToKit + request_from = browser socket.id (Socket.IO routing by to_kit_id)" style="html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=400;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="1150" as="sourcePoint"/><mxPoint x="820" y="1150" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m11" value="11. messageToKit-kitReply {cmd: subscribe_apis, result: Successful, request_from} (Socket.IO)" style="html=1;dashed=1;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=400;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="1230" as="sourcePoint"/><mxPoint x="380" y="1230" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m12" value="12. messageToKit-kitReply → request_from browser socket (Socket.IO event)" style="html=1;dashed=1;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=200;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="1310" as="sourcePoint"/><mxPoint x="160" y="1310" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m13" value="13. GET /healthz :3090, HTTP 200 (optional local operator check; browser access assumed)" style="html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=400;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="1390" as="sourcePoint"/><mxPoint x="600" y="1390" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="m14" value="14. messageToKit {cmd: run_python_app, data: {name, code}, usedAPIs, to_kit_id} (Socket.IO; Run UI assumed)" style="html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=200;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="1600" as="sourcePoint"/><mxPoint x="380" y="1600" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m15" value="15. messageToKit {request_from, cmd: run_python_app, data.code, ...} (Socket.IO)" style="html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=400;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="1680" as="sourcePoint"/><mxPoint x="820" y="1680" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m16" value="16. writeCodeToFile(main.py), or create_project_from_json(app/) + pip install -r app/requirements.txt (filesystem / subprocess)" style="html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=200;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="1820" as="sourcePoint"/><mxPoint x="1040" y="1820" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m17" value="17. subpiper: python -u main.py OR python -u app/main.py (OS child process)" style="html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=200;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="1980" as="sourcePoint"/><mxPoint x="1040" y="1980" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m18" value="18. VehicleApp.run() / on_start(); Vehicle.Speed.subscribe(callback) (SDK / gRPC SDV Broker.Subscribe)" style="html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=200;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1040" y="2100" as="sourcePoint"/><mxPoint x="1260" y="2100" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m19" value="19. Vehicle.Speed.get() → GetDatapoints {datapoints: [Vehicle.Speed]} (gRPC SDV Databroker v1)" style="html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=200;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1040" y="2180" as="sourcePoint"/><mxPoint x="1260" y="2180" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m20" value="20. GetDatapointsReply: Vehicle.Speed value / failure_value (gRPC)" style="html=1;dashed=1;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=200;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1260" y="2260" as="sourcePoint"/><mxPoint x="1040" y="2260" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m21" value="21. Vehicle.Body.Lights.Beam.High.IsOn.set(true) → SetDatapoints (gRPC SDV v1; speed &gt; 110 application rule assumed, not stored in repo)" style="html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=200;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1040" y="2440" as="sourcePoint"/><mxPoint x="1260" y="2440" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m22" value="22. SetDatapointsReply {errors: {}} or per-path DatapointError; acceptance is not remote feedback (gRPC)" style="html=1;dashed=1;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=200;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1260" y="2520" as="sourcePoint"/><mxPoint x="1040" y="2520" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m23" value="23. OR messageToKit {cmd: write_signals_value, data: {Vehicle.Body.Lights.Beam.High.IsOn: true}} (Socket.IO; widget assumed)" style="html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=200;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="2600" as="sourcePoint"/><mxPoint x="380" y="2600" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m24" value="24. messageToKit + request_from (Socket.IO); set_mock_signals also writes current values with MOCK_SIGNAL=&quot;&quot;" style="html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=400;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="2680" as="sourcePoint"/><mxPoint x="820" y="2680" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m25" value="25. writeSignalsValue → set_current_values / VAL.Set [VALUE] (gRPC KUKSA VAL v1 :55555)" style="html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=400;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="2760" as="sourcePoint"/><mxPoint x="1260" y="2760" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m26" value="26. VAL.Set response / RpcError (gRPC); command forwarder observes command-capable current/target writes" style="html=1;dashed=1;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=400;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1260" y="2840" as="sourcePoint"/><mxPoint x="820" y="2840" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m27" value="27. messageToKit-kitReply {cmd, result: Successful | Failed, error?} (Socket.IO)" style="html=1;dashed=1;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=400;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="2920" as="sourcePoint"/><mxPoint x="380" y="2920" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m28" value="28. messageToKit-kitReply routed to request_from (Socket.IO event)" style="html=1;dashed=1;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=200;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="3000" as="sourcePoint"/><mxPoint x="160" y="3000" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m29" value="29. actuation_to_message → send_actuation; /body_control_module/local_tx, high_beam_state=true (LoLa SHM)" style="html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=200;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1260" y="3160" as="sourcePoint"/><mxPoint x="1480" y="3160" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m30" value="30. GenericProxy consumes high_beam_state; serialize bool to 0x01 (mw::com SHM event)" style="html=1;dashed=1;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=200;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1480" y="3240" as="sourcePoint"/><mxPoint x="1700" y="3240" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m31" value="31. App→SOME/IP: service 0x4300, instance 0x1000, event 0x8430 (SOCom IPC)" style="html=1;dashed=1;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=200;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1700" y="3320" as="sourcePoint"/><mxPoint x="1920" y="3320" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m32" value="32. subscribed event 0x4300/0x1000/0x8430, payload 0x01 (local SOME/IP / vsomeip)" style="html=1;dashed=1;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=200;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1920" y="3400" as="sourcePoint"/><mxPoint x="2140" y="3400" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m33" value="33. sendto(SDV_REMOTE_IP:35001), Encode 46-byte frame, payload 0x01 (UDP / HBG1 v1)" style="html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=200;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2140" y="3480" as="sourcePoint"/><mxPoint x="2360" y="3480" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m34" value="34. Decode + SetOutboundState(true) → GpioOutput::Write(true), LED ON (Linux GPIO ioctl)" style="html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=200;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2360" y="3560" as="sourcePoint"/><mxPoint x="2580" y="3560" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="m35" value="35. Optional pressed/released switch: MonitorGpio BCM17, debounce, shared high-beam state (GPIO event)" style="html=1;dashed=1;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=200;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2580" y="3770" as="sourcePoint"/><mxPoint x="2360" y="3770" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m36" value="36. High-beam state on change + every 2 s; service 0x4300 / instance 0x1001 / event 0x8431 (UDP → HW-1:35000)" style="html=1;dashed=1;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=200;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2360" y="3850" as="sourcePoint"/><mxPoint x="2140" y="3850" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m37" value="37. OR menu option 2: Vehicle.speed=113; service 6433 / instance 2 / event 1, f64 + quality=3 (UDP)" style="html=1;dashed=1;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=200;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2360" y="3930" as="sourcePoint"/><mxPoint x="2140" y="3930" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m38" value="38. Decode + route lookup; notify(service, remote_instance, remote_event, payload) (SOME/IP)" style="html=1;dashed=1;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=200;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2140" y="4010" as="sourcePoint"/><mxPoint x="1920" y="4010" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m39" value="39. Network→IPC event delivery (SOCom IPC; not a direct cloud connection)" style="html=1;dashed=1;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=200;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1920" y="4090" as="sourcePoint"/><mxPoint x="1700" y="4090" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m40" value="40. Deserialize + GenericSkeleton publishes /body_control_module/network_rx or /Vehicle/Service2/Instance (LoLa SHM)" style="html=1;dashed=1;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=200;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1700" y="4170" as="sourcePoint"/><mxPoint x="1480" y="4170" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m41" value="41. Typed Rx polling → message_to_update; Vehicle.Body.Lights.Beam.High.IsOn / Vehicle.Speed (mw::com)" style="html=1;dashed=1;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=200;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1480" y="4250" as="sourcePoint"/><mxPoint x="1260" y="4250" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m42" value="42. SubscribeReply updates / GetDatapointsReply: current VSS value (gRPC SDV v1); feedback flagged to prevent command echo" style="html=1;dashed=1;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=200;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1260" y="4330" as="sourcePoint"/><mxPoint x="1040" y="4330" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m43" value="43. ticker_fast every 0.3 s: get_current_values([api]) / VAL.Get (gRPC VAL v1; dashboard subscription is polling)" style="html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=400;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="4410" as="sourcePoint"/><mxPoint x="1260" y="4410" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m44" value="44. Datapoint(value); float arrays converted to JSON lists (gRPC response)" style="html=1;dashed=1;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=400;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1260" y="4490" as="sourcePoint"/><mxPoint x="820" y="4490" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m45" value="45. messageToKit-kitReply {cmd: apis-value, result: {VSS path: value}, kit_id, request_from} (Socket.IO)" style="html=1;dashed=1;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=400;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="4570" as="sourcePoint"/><mxPoint x="380" y="4570" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m46" value="46. messageToKit-kitReply {cmd: apis-value} → request_from (Socket.IO event)" style="html=1;dashed=1;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=200;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="4650" as="sourcePoint"/><mxPoint x="160" y="4650" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="widget-note" value="Dashboard widgets / Signal Watch bind apis-value VSS paths to displayed values (assumed: browser source absent). Vehicle API model names must match the broker. Speed and high-beam updates can arrive independently. Remote non-high-beam body commands are echoed; this does not prove a physical actuator operated." style="shape=note;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="65" y="4700" width="620" height="95" as="geometry"/></mxCell>
        <mxCell id="m47" value="47. stdout / stderr line → my_stdout_callback (OS pipes / subpiper)" style="html=1;dashed=1;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=200;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1040" y="4850" as="sourcePoint"/><mxPoint x="820" y="4850" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m48" value="48. messageToKit-kitReply {cmd: run_python_app, isDone: false, code: 0, result: line} (Socket.IO)" style="html=1;dashed=1;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=400;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="4930" as="sourcePoint"/><mxPoint x="380" y="4930" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m49" value="49. messageToKit-kitReply → console / terminal rendering (Socket.IO event; rendering assumed)" style="html=1;dashed=1;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=200;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="5010" as="sourcePoint"/><mxPoint x="160" y="5010" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m50" value="50. report-runtime-state {noOfRunner, noOfApiSubscriber}, when roster changes, 1 s check (Socket.IO)" style="html=1;dashed=1;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=400;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="5090" as="sourcePoint"/><mxPoint x="380" y="5090" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m51" value="51. messageToKit-kitReply {cmd: report-runtime-state, data: {lsOfRunner, lsOfApiSubscriber}} (Socket.IO)" style="html=1;dashed=1;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=400;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="5170" as="sourcePoint"/><mxPoint x="380" y="5170" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m52" value="52. messageToKit-kitReply + list-all-kits-result on roster change (Socket.IO events)" style="html=1;dashed=1;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=200;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="5250" as="sourcePoint"/><mxPoint x="160" y="5250" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m53" value="53. messageToKit {cmd: get-runtime-info, to_kit_id} (Socket.IO; UI assumed)" style="html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=200;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="5330" as="sourcePoint"/><mxPoint x="380" y="5330" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m54" value="54. messageToKit {cmd: get-runtime-info, request_from} (Socket.IO)" style="html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=400;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="5410" as="sourcePoint"/><mxPoint x="820" y="5410" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m55" value="55. messageToKit-kitReply {cmd: get-runtime-info, data: {lsOfRunner, lsOfApiSubscriber}} (Socket.IO)" style="html=1;dashed=1;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=400;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="5490" as="sourcePoint"/><mxPoint x="380" y="5490" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m56" value="56. messageToKit-kitReply routed to request_from (Socket.IO event)" style="html=1;dashed=1;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=200;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="5570" as="sourcePoint"/><mxPoint x="160" y="5570" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="m57" value="57. alt [missing code / pip failure]: run_python_app error result or nonzero code (Socket.IO reply)" style="html=1;dashed=1;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=400;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="5820" as="sourcePoint"/><mxPoint x="380" y="5820" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m58" value="58. messageToKit-kitReply → error display (Socket.IO; UI assumed)" style="html=1;dashed=1;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=200;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="5900" as="sourcePoint"/><mxPoint x="160" y="5900" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m59" value="59. alt [Socket.IO disconnect]: mark kit is_online=false; subsequent list-all-kits-result (Socket.IO event)" style="html=1;dashed=1;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=200;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="5980" as="sourcePoint"/><mxPoint x="160" y="5980" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m60" value="60. reconnect via socketio.AsyncClient defaults (assumed library policy); connect() emits register_kit again (Socket.IO)" style="html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=400;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="6060" as="sourcePoint"/><mxPoint x="380" y="6060" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m61" value="61. alt [KUKSA client disconnected]: ticker_fast client.connect() (gRPC); per-api read failures are skipped, not sent as explicit widget errors" style="html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=400;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="6140" as="sourcePoint"/><mxPoint x="1260" y="6140" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m62" value="62. unsubscribe_apis or stop_python_app through messageToKit (Socket.IO; Stop UI assumed)" style="html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=200;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="6220" as="sourcePoint"/><mxPoint x="380" y="6220" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m63" value="63. messageToKit + request_from; unsubscribe removes client API list (Socket.IO)" style="html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=400;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="6300" as="sourcePoint"/><mxPoint x="820" y="6300" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m64" value="64. stop_python_app → runner.kill(); OR ticker expires runner after 180 s / subscriber after 60 s (OS / timer)" style="html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=200;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="6380" as="sourcePoint"/><mxPoint x="1040" y="6380" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m65" value="65. process_done(retcode) (OS child completion callback)" style="html=1;dashed=1;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=200;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1040" y="6460" as="sourcePoint"/><mxPoint x="820" y="6460" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m66" value="66. messageToKit-kitReply {cmd: run_python_app, isDone: true, code: retcode, result: &quot;&quot;} (Socket.IO)" style="html=1;dashed=1;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=400;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="6540" as="sourcePoint"/><mxPoint x="380" y="6540" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m67" value="67. messageToKit-kitReply → final app status / return code (Socket.IO event)" style="html=1;dashed=1;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=200;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="6620" as="sourcePoint"/><mxPoint x="160" y="6620" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m68" value="68. clientUnsubscribeToKit {kit_id}; unregister_client; disconnect (Socket.IO; UI assumed)" style="html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=200;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="6700" as="sourcePoint"/><mxPoint x="380" y="6700" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m69" value="69. Docker stop → start_services.sh TERM handler terminates Kit Manager and syncer (OS signals; operator action)" style="html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=200;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="6860" as="sourcePoint"/><mxPoint x="820" y="6860" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m70" value="70. Socket.IO disconnect: kit offline; offline TTL sweeper removes stale entry (server state event)" style="html=1;dashed=1;endArrow=open;endFill=0;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=400;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="6940" as="sourcePoint"/><mxPoint x="380" y="6940" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="teardown-note" value="Container shutdown does not stop the native HW-1 Databroker / SCORE stack or remote_app. start_services.sh also tears down siblings if Kit Manager or syncer exits. UDP has no reconnect/ACK session; malformed frames are logged and discarded by remote/bridge. GPIO output failure is logged locally; no dedicated cloud GPIO-error event is implemented." style="shape=note;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="70" y="7080" width="2630" height="110" as="geometry"/></mxCell>
        <mxCell id="deploy-note" value="Alternative deploy API (not the run_python_app execution path): Kit Manager accepts messageToKit cmd=deploy_request / deploy_n_run and produces convertedCode, but syncer deploy_request / deploy-request only writes main.py and emits staged progress strings (including 'Build docker image'); those strings are not actual builds or launches. deploy_n_run has no matching syncer branch. No successful deployment sequence is invented here." style="shape=note;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="70" y="7220" width="2630" height="110" as="geometry"/></mxCell>

        <mxCell id="transport-note" value="Transport boundaries: default Socket.IO client may negotiate polling/WebSocket; no WebSocket-only claim. Kit Manager :3090 is a local HTTP/Socket.IO server, not a hop to the default cloud endpoint. Mosquitto starts locally; sample MQTT topics sampleapp/getSpeed, sampleapp/getSpeed/response, sampleapp/currentSpeed are not an active headlight/cloud transport (sample publications are commented out). No Zenoh, Kubernetes, vehicle simulator, or remote SOME/IP daemon participates in this selected launcher flow. high_beam uses event 0x8430 outward / 0x8431 return. Speed uses numeric event 1 in both instances; text speedAck is not a separate VSS property." style="shape=note;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacing=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="7550" width="2700" height="120" as="geometry"/></mxCell>
        <mxCell id="sources" value="Evidence in repository checkout (fork remote: goutham3108/sdv-hackathon-in-a-box-fork-): README.md; ARCHITECTURE.md; patch/sdv-runtime/Dockerfile, start_services.sh, Kit-Manager/src/index.js, Kit-Manager/src/convert_code.js, kuksa-syncer/syncer.py, kuksa-syncer/subpiper/subpiper.py, kuksa-syncer/velocitas_app.py; kuksa-databroker/databroker-mw-com/src/main.rs, databroker/src/grpc/sdv_databroker_v1.rs, mw_com_provider/src/provider.rs, gateway_adapter.rs; sdv-hack-demo/deploy/start-vehicle.sh, deploy/start-remote.sh, signal_routes.json, include/high_beam_udp_protocol.h, bridge/main.cpp, remote_app/main.cpp. Application speed threshold and UI rendering are external/assumed, not verified frontend source. This diagram models actual middleware adapter behavior; it does not rename an in-process provider into a separate gRPC client." style="shape=note;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacing=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="7700" width="2700" height="160" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
